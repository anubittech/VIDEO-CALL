# Server Port
PORT=5000

# Neon PostgreSQL Connection String
# Format: postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key (Use a strong random string of at least 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key-min-32-chars"

# Frontend Client Origin for CORS and Invitation Links
CLIENT_URL="http://localhost:3000"

