{
  "name": "pulsemeet-backend",
  "version": "1.0.0",
  "description": "Real-Time Video Calling and Screen Sharing Backend (Express + Socket.IO + Prisma + Neon PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
